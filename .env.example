# Relay is multi-provider: it reaches every model through an OpenAI-compatible
# API, selected per role. Set the key(s) for the provider(s) you actually use.

# OpenRouter (the default provider for both roles).
OPENROUTER_API_KEY=

# DeepSeek (direct). Only needed if a role uses provider=deepseek.
# DeepSeek gives new accounts free signup tokens.
DEEPSEEK_API_KEY=

# --- Models are resolved by role; swapping is an env change, never code. -----
#   brain = the planner ("thinks");  hands = the executor ("does")
# Each role names BOTH a provider and a model id.

# The model id for each role. Any slug valid for that role's provider works.
RELAY_BRAIN_MODEL=anthropic/claude-sonnet-4.5
RELAY_HANDS_MODEL=anthropic/claude-3.5-haiku

# The provider for each role (default: openrouter). Known: openrouter, deepseek.
# e.g. to run the executor on DeepSeek direct:
#   RELAY_HANDS_PROVIDER=deepseek
#   RELAY_HANDS_MODEL=deepseek-v4-flash
RELAY_BRAIN_PROVIDER=openrouter
RELAY_HANDS_PROVIDER=openrouter

# Thinking mode per role (default: off). Relay's text protocol parses a single
# content blob, so thinking is off by default; enable it per role if you want it.
#   RELAY_BRAIN_THINKING=1
#   RELAY_HANDS_THINKING=1

# --- Model catalog (metadata + pricing) overrides (optional, power-user) -----
# Relay pulls model pricing/capabilities/limits from a catalog (default
# https://models.dev). These rarely need touching:
#   RELAY_MODELS_URL=            # override the catalog source (or a local api.json)
#   RELAY_DISABLE_MODELS_FETCH=  # set to 1 to skip the network (cache/bundled only)
#   RELAY_CACHE_DIR=             # where the on-disk catalog cache lives
