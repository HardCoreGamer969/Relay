# Relay reaches every model through OpenRouter (https://openrouter.ai).
# OpenRouter is the only backend — no other provider keys are needed.
OPENROUTER_API_KEY=

# Swap models purely via these env vars — no code change required.
# Any OpenRouter model slug works. Models are resolved by role:
#   brain  = the planner ("thinks")
#   hands  = the executor ("does")
RELAY_BRAIN_MODEL=anthropic/claude-sonnet-4.5
RELAY_HANDS_MODEL=anthropic/claude-3.5-haiku
