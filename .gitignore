# Secrets / local env
.env

# Virtual environments
.venv/
venv/
env/
ENV/

# Python caches & bytecode
__pycache__/
*.py[cod]
*$py.class

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
